#  OncoScan : variables d'environnement
#  Copier ce fichier en .env puis remplacer chaque valeur « change-me ».
#  Le .env n'est jamais versionné (voir .gitignore).
#
#  Générer un secret solide :
#    python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------
#  Version et publication des images
# ---------------------------------------------------------------------
# Tag des images Docker (doit suivre les tags git vX.Y.Z)
VERSION=2.3.0
# Compte Docker Hub qui héberge les images oncoscan-api, oncoscan-app, oncoscan-evidently
DOCKERHUB_USER=change-me

# ---------------------------------------------------------------------
#  Base de données PostgreSQL
# ---------------------------------------------------------------------
# Lus uniquement à la création du volume pgdata. Pour changer le mot de passe
# d'une base existante : ALTER ROLE ... PASSWORD (voir README, « Rotation des secrets »).
DB_NAME=oncoscan
DB_USER=oncoscan
DB_PASSWORD=change-me

# ---------------------------------------------------------------------
#  API d'inférence
# ---------------------------------------------------------------------
# Clé partagée entre l'interface et l'API (en-tête X-API-Key)
API_KEY=change-me
# DEBUG, INFO, WARNING ou ERROR (vaut aussi pour le job Evidently)
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
#  Interface web
# ---------------------------------------------------------------------
# true : l'écran de connexion propose « Créer un compte ». À fermer (false) dès
# que les comptes des praticiens existent.
ALLOW_REGISTRATION=false
# Fuseau utilisé pour afficher les dates de l'historique
APP_TIMEZONE=Europe/Paris
# Nom du modèle affiché en pied de page
MODEL_NAME=Régression logistique calibrée

# ---------------------------------------------------------------------
#  Monitoring (docker-compose.monitoring.yml)
# ---------------------------------------------------------------------
# Compte administrateur de Grafana, distinct des comptes de l'application.
# Créé au premier démarrage seulement : le modifier ensuite demande une
# réinitialisation (voir Monitoring/README.md).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Utilisateur PostgreSQL en lecture seule pour Grafana et Evidently
# (créé avec Monitoring/sql/readonly_user.sql). Vides : DB_USER est réutilisé.
MONITORING_DB_USER=oncoscan_monitoring
MONITORING_DB_PASSWORD=change-me

# Job Evidently : fenêtre analysée (jours), fréquence (secondes), minimum de
# prédictions en dessous duquel le drift n'est pas calculé
EVIDENTLY_WINDOW_DAYS=30
EVIDENTLY_INTERVAL_SECONDS=3600
EVIDENTLY_MIN_ROWS=30

# Durée de conservation des métriques dans Prometheus
PROMETHEUS_RETENTION=30d

# ---------------------------------------------------------------------
#  Suivi des expériences (Model/train.py)
# ---------------------------------------------------------------------
# Laissé vide : base SQLite locale (mlflow.db). Sinon, URL d'un serveur MLflow.
# Lu par train.py depuis l'environnement du terminal, pas par docker compose.
MLFLOW_TRACKING_URI=
