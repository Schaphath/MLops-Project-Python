    {
      "id": 50,
      "type": "timeseries",
      "title": "Prédictions par jour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oncoscan-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oncoscan-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time,\n       count(*) FILTER (WHERE prediction = 'M') AS \"Maligne\",\n       count(*) FILTER (WHERE prediction = 'B') AS \"Bénigne\"\nFROM predictions\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Maligne"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bénigne"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 51,
      "type": "table",
      "title": "Modèle vs diagnostic du médecin (période)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oncoscan-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oncoscan-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE prediction WHEN 'M' THEN 'Maligne' ELSE 'Bénigne' END AS \"Prédit\",\n       CASE doctor_feedback WHEN 'M' THEN 'Maligne' WHEN 'B' THEN 'Bénigne' ELSE 'En attente' END AS \"Confirmé\",\n       count(*) AS \"Nombre\"\nFROM predictions\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Matrice de confusion à partir du feedback. Ligne Prédit=Bénigne / Confirmé=Maligne = faux négatifs."
    },
    {
      "id": 52,
      "type": "stat",
      "title": "En attente de validation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "oncoscan-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "oncoscan-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE doctor_feedback = 'UNCONFIRMED')::float / NULLIF(count(*), 0) AS \"En attente\"\nFROM predictions\nWHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
