      "type": "stat",
      "title": "Prédictions (période)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(oncoscan_predictions_total[$__range]))",
          "legendFormat": "__auto",
          "refId": "K",
          "instant": true,
          "range": false
