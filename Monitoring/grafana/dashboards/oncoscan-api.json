          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"oncoscan-api\",handler=\"/predict\"}[5m])))",
          "legendFormat": "p99",
          "refId": "Q"
        }
