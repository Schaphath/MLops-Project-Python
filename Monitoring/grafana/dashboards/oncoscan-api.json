          "expr": "sum by (handler, status) (rate(http_requests_total{job=\"oncoscan-api\"}[5m]))",
          "legendFormat": "{{handler}} {{status}}",
          "refId": "M"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
