    {
      "id": 20,
      "type": "timeseries",
      "title": "Prédictions par classe (par minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (prediction) (rate(oncoscan_predictions_total[5m])) * 60",
          "legendFormat": "{{prediction}}",
          "refId": "T"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "M"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Maligne"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "Bénigne"
              }
            ]
          }
        ]
      }
