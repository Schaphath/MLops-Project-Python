    {
      "id": 22,
      "type": "bargauge",
      "title": "Distribution de la probabilité de malignité (période)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(oncoscan_probability_malignant_bucket[$__range]))",
          "legendFormat": "≤ {{le}}",
          "refId": "V",
          "instant": true,
          "range": false,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "description": "Nombre de prédictions par tranche de probabilité. Un glissement vers le milieu (0.3-0.7) signale un modèle moins sûr de lui.",
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
